ZAM_AI_ENVIRONMENT=local
ZAM_AI_SERVICE_NAME=zam-ai-core-api
ZAM_AI_SERVICE_VERSION=0.1.0
ZAM_AI_LOG_LEVEL=INFO
ZAM_AI_INTERNAL_API_KEYS=local-dev-key
ZAM_AI_READINESS_CHECK_DEPENDENCIES=false
ZAM_AI_EMBEDDING_PROVIDER=jina
ZAM_AI_VOYAGE_API_KEY=
ZAM_AI_VOYAGE_EMBEDDING_MODEL=voyage-3
ZAM_AI_JINA_API_KEY=
ZAM_AI_GEMINI_API_KEY=
ZAM_AI_EMBEDDING_BATCH_TIMEOUT=180

ZAM_AI_MODEL_PROVIDER=claude
ZAM_AI_CLAUDE_API_KEY=
ZAM_AI_CLAUDE_MODEL=claude-sonnet-4-20250514
ZAM_AI_GEMINI_MODEL=gemini-2.0-flash

ZAM_AI_VECTOR_STORE=pinecone
ZAM_AI_PINECONE_API_KEY=
ZAM_AI_PINECONE_INDEX_NAME=zam-ai
ZAM_AI_QDRANT_URL=http://localhost:6333
ZAM_AI_QDRANT_API_KEY=
ZAM_AI_QDRANT_COLLECTION_NAME=zam-ai

# Database — SQLite default for local dev. Set to Neon URL for production.
# ZAM_AI_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk auth — required for user-facing endpoints
# ZAM_AI_CLERK_SECRET_KEY=sk_test_...
# ZAM_AI_CLERK_PUBLISHABLE_KEY=pk_test_...
# ZAM_AI_CLERK_WEBHOOK_SECRET=whsec_...

